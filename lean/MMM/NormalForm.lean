/-
Written by mistralai/mistral-large-4-0 (AI, worker W023), 2026-11-14. Machine-checked by Lean when
this file compiles; not human-reviewed.

Lemma "Normal form" of the paper: the rotation equivalence `Rot` (defined directly in its normal
form in `MMM/Trees.lean`) is exactly the equivalence relation generated by the single rotations
`RotStep` below (one cyclic shift of the children of one node, anywhere in the tree).

(The second constructor is named `under` instead of `below`: with the name `below` the inductive
does not pass the Lean kernel in this Mathlib version. The meaning is unchanged.)
-/
import MMM.RotEquiv
import Mathlib.Logic.Relation

namespace MMM

namespace PTree

/-- One rotation: the children of one node, anywhere in the tree, are shifted cyclically by
one position. -/
inductive RotStep {p : ℕ} [NeZero p] : PTree p → PTree p → Prop
  | here (f : Fin p → PTree p) : RotStep (node f) (node fun i => f (i + 1))
  | under (f : Fin p → PTree p) (i : Fin p) (T : PTree p) (h : RotStep (f i) T) :
      RotStep (node f) (node (Function.update f i T))

variable {p : ℕ} [NeZero p]

/-- A single rotation is a rotation equivalence. -/
theorem RotStep.rot {S T : PTree p} (h : RotStep S T) : Rot S T := by
  induction h with
  | here f => exact Rot.node f _ 1 (fun i => Rot.refl _)
  | under f i T _ ih =>
    refine Rot.node f _ 0 (fun j => ?_)
    by_cases hji : j = i
    · subst hji
      simpa using ih
    · simpa [Function.update_of_ne hji] using Rot.refl (f j)

/-- The equivalence closure of the single rotations is contained in `Rot`. -/
theorem rot_of_eqvGen {S T : PTree p} (h : Relation.EqvGen RotStep S T) : Rot S T := by
  induction h with
  | rel _ _ h => exact h.rot
  | refl => exact Rot.refl _
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih1 ih2 => exact ih1.trans ih2

/-- An equivalence of subtrees lifts through one child position. -/
theorem eqvGen_update (F : Fin p → PTree p) (i : Fin p) {A B : PTree p}
    (h : Relation.EqvGen RotStep A B) :
    Relation.EqvGen RotStep (node (Function.update F i A)) (node (Function.update F i B)) := by
  induction h with
  | rel x y h =>
    have h' : RotStep (Function.update F i x i) y := by
      rw [Function.update_self]
      exact h
    have hstep := RotStep.under (Function.update F i x) i y h'
    rw [Function.update_idem] at hstep
    exact Relation.EqvGen.rel _ _ hstep
  | refl => exact Relation.EqvGen.refl _
  | symm _ _ _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans _ _ _ _ _ ih1 ih2 => exact Relation.EqvGen.trans _ _ _ ih1 ih2

/-- If the children of two nodes are equivalent one by one, so are the nodes. -/
theorem eqvGen_node {f g : Fin p → PTree p} (h : ∀ i, Relation.EqvGen RotStep (f i) (g i)) :
    Relation.EqvGen RotStep (node f) (node g) := by
  have key : ∀ (s : Finset (Fin p)) (f g : Fin p → PTree p),
      (∀ i ∈ s, Relation.EqvGen RotStep (f i) (g i)) → (∀ i, i ∉ s → f i = g i) →
      Relation.EqvGen RotStep (node f) (node g) := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      intro f g _ hag
      rw [funext fun i => hag i (Finset.notMem_empty i)]
      exact Relation.EqvGen.refl _
    | insert i s his ih =>
      intro f g hs hag
      have h1 : Relation.EqvGen RotStep (node f) (node (Function.update g i (f i))) := by
        refine ih f (Function.update g i (f i)) ?_ ?_
        · intro j hj
          have hji : j ≠ i := fun h => his (h ▸ hj)
          simp only [Function.update_of_ne hji]
          exact hs j (Finset.mem_insert_of_mem hj)
        · intro j hj
          by_cases hji : j = i
          · subst hji
            exact (Function.update_self (f := g) _ _).symm
          · simp only [Function.update_of_ne hji]
            exact hag j (fun hm => (Finset.mem_insert.mp hm).elim (fun h => hji h) hj)
      have h2 : Relation.EqvGen RotStep (node (Function.update g i (f i))) (node g) := by
        have hstep := eqvGen_update g i (hs i (Finset.mem_insert_self i s))
        rwa [Function.update_eq_self] at hstep
      exact Relation.EqvGen.trans _ _ _ h1 h2
  exact key Finset.univ f g (fun i _ => h i) (fun i hi => absurd (Finset.mem_univ i) hi)

/-- Shifting the children of the root by `r` is a chain of single rotations at the root. -/
theorem eqvGen_shift (f : Fin p → PTree p) (r : Fin p) :
    Relation.EqvGen RotStep (node f) (node fun i => f (i + r)) := by
  have key : ∀ (n : ℕ) (r : Fin p), r.val = n →
      Relation.EqvGen RotStep (node f) (node fun i => f (i + r)) := by
    intro n
    induction n with
    | zero =>
      intro r hr
      have h0 : r = 0 := Fin.eq_of_val_eq (by simpa using hr)
      subst h0
      simp only [add_zero]
      exact Relation.EqvGen.refl _
    | succ n ih =>
      intro r hr
      have hlt : n + 1 < p := by rw [← hr]; exact r.isLt
      have hn : n < p := by omega
      have hreq : r = (⟨n, hn⟩ : Fin p) + 1 := by
        refine Fin.eq_of_val_eq ?_
        have h1 : 1 % p = 1 := Nat.mod_eq_of_lt (by omega : 1 < p)
        have h2 : (n + 1) % p = n + 1 := Nat.mod_eq_of_lt hlt
        simp only [Fin.val_add, Fin.val_one', h1, h2, hr]
      have h1 := ih ⟨n, hn⟩ rfl
      have hstep : RotStep (node fun i => f (i + (⟨n, hn⟩ : Fin p)))
          (node fun i => f ((i + 1) + (⟨n, hn⟩ : Fin p))) := RotStep.here _
      have heq : (fun i => f ((i + 1) + (⟨n, hn⟩ : Fin p))) = (fun i => f (i + r)) := by
        funext i
        have hfin : (i + 1) + (⟨n, hn⟩ : Fin p) = i + r := by
          rw [hreq]
          exact (add_right_comm i 1 ⟨n, hn⟩).trans (add_assoc i ⟨n, hn⟩ 1)
        rw [hfin]
      rw [heq] at hstep
      exact Relation.EqvGen.trans _ _ _ h1 (Relation.EqvGen.rel _ _ hstep)
  exact key r.val r rfl

/-- `Rot` implies the equivalence closure of the single rotations. -/
theorem eqvGen_of_rot {S T : PTree p} (h : Rot S T) : Relation.EqvGen RotStep S T := by
  induction h with
  | leaf => exact Relation.EqvGen.refl _
  | node f g r _ ih =>
    exact Relation.EqvGen.trans _ _ _ (eqvGen_shift f r) (eqvGen_node (fun i => ih i))

/-- **Lemma "Normal form" of the paper:** the rotation equivalence in normal form is exactly the
equivalence relation generated by rotating the children of one node, anywhere in the tree. -/
theorem rot_iff_eqvGen {p : ℕ} [NeZero p] (S T : PTree p) :
    Rot S T ↔ Relation.EqvGen RotStep S T :=
  ⟨eqvGen_of_rot, rot_of_eqvGen⟩

end PTree

end MMM
