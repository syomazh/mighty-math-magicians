/-
Written by Kimi K3.1 Pro, 2026-11-14. Not human-reviewed.

The commutative ring of Hurwitz series in finitely many variables, its
partial derivations ∂/∂z_c, and the p-th power and `f^p / p` formulas of
Lemma `lem:hur` of `paper/frobenius_proof.tex`.

A Hurwitz series is represented by its integer coefficient function
`a ↦ f_a` (the coefficient of `z^a / a!`).  The product is binomial
convolution; the partial derivative is the shift by the unit vector.

The commutative-ring structure is built by transferring from
`MvPowerSeries ι ℚ` along the injective rescaling
`f ↦ (a ↦ f.coeff a / ∏ i, (a i)!)`.
-/
import Mathlib.RingTheory.MvPowerSeries.Derivative
import Mathlib.Data.Finsupp.Antidiagonal
import Mathlib.Data.Finsupp.Basic
import Mathlib.Data.Fintype.Pi
import Mathlib.Data.Nat.Factorial.Basic
import Mathlib.Data.ZMod.Basic
import Mathlib.Data.Nat.Choose.Basic
import Mathlib.Data.Nat.Choose.Dvd
import Mathlib.Algebra.Ring.InjSurj
import Mathlib.Algebra.BigOperators.Field
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Push
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Linarith

noncomputable section

namespace MMM.Frob

universe u

variable {ι : Type u}

/-- A Hurwitz series in variables indexed by `ι`: `coeff a` is the integer
coefficient of `z^a / a!`. -/
@[ext]
structure Hur (ι : Type u) where
  coeff : (ι → ℕ) → ℤ

namespace Hur

section Basic

variable [Fintype ι] [DecidableEq ι]

/-- The zero Hurwitz series: all coefficients vanish. -/
protected def zero : Hur ι := ⟨fun _ => 0⟩

/-- The unit Hurwitz series: the coefficient of `z^0 / 0!` is one. -/
protected def one : Hur ι := ⟨fun a => if a = 0 then 1 else 0⟩

protected def add (f g : Hur ι) : Hur ι := ⟨fun a => f.coeff a + g.coeff a⟩
protected def neg (f : Hur ι) : Hur ι := ⟨fun a => -f.coeff a⟩
protected def sub (f g : Hur ι) : Hur ι := ⟨fun a => f.coeff a - g.coeff a⟩

/-- Product of coordinatewise binomial coefficients. -/
def mchoose (a b : ι → ℕ) : ℕ := ∏ i, (a i).choose (b i)

/-- The product as a binomial convolution of the coefficient functions. -/
protected def mul (f g : Hur ι) : Hur ι :=
  ⟨fun a => ∑ b ∈ Fintype.piFinset (fun i => Finset.range (a i + 1)),
    (mchoose a b : ℤ) * f.coeff b * g.coeff (a - b)⟩

instance : Zero (Hur ι) := ⟨Hur.zero⟩
instance : One (Hur ι) := ⟨Hur.one⟩
instance : Add (Hur ι) := ⟨Hur.add⟩
instance : Neg (Hur ι) := ⟨Hur.neg⟩
instance : Sub (Hur ι) := ⟨Hur.sub⟩
instance : Mul (Hur ι) := ⟨Hur.mul⟩
instance : SMul ℕ (Hur ι) := ⟨fun n f => ⟨fun a => n * f.coeff a⟩⟩
instance : SMul ℤ (Hur ι) := ⟨fun n f => ⟨fun a => n * f.coeff a⟩⟩
instance : Pow (Hur ι) ℕ := ⟨fun f n => npowRec n f⟩
instance : NatCast (Hur ι) := ⟨fun n => ⟨fun a => if a = 0 then n else 0⟩⟩
instance : IntCast (Hur ι) := ⟨fun n => ⟨fun a => if a = 0 then n else 0⟩⟩

@[simp] theorem coeff_zero_raw (a : ι → ℕ) : (0 : Hur ι).coeff a = 0 := rfl

@[simp] theorem coeff_one_raw (a : ι → ℕ) :
    (1 : Hur ι).coeff a = if a = 0 then 1 else 0 := rfl

@[simp] theorem coeff_add_raw (f g : Hur ι) (a : ι → ℕ) :
    (f + g).coeff a = f.coeff a + g.coeff a := rfl

@[simp] theorem coeff_neg_raw (f : Hur ι) (a : ι → ℕ) :
    (-f).coeff a = -f.coeff a := rfl

@[simp] theorem coeff_sub_raw (f g : Hur ι) (a : ι → ℕ) :
    (f - g).coeff a = f.coeff a - g.coeff a := rfl

@[simp] theorem coeff_nsmul_raw (n : ℕ) (f : Hur ι) (a : ι → ℕ) :
    (n • f).coeff a = n * f.coeff a := rfl

@[simp] theorem coeff_zsmul_raw (n : ℤ) (f : Hur ι) (a : ι → ℕ) :
    (n • f).coeff a = n * f.coeff a := rfl

@[simp] theorem coeff_mul_raw (f g : Hur ι) (a : ι → ℕ) :
    (f * g).coeff a = ∑ b ∈ Fintype.piFinset (fun i => Finset.range (a i + 1)),
      (mchoose a b : ℤ) * f.coeff b * g.coeff (a - b) := rfl

@[simp] theorem coeff_natCast_raw (n : ℕ) (a : ι → ℕ) :
    ((n : Hur ι)).coeff a = if a = 0 then (n : ℤ) else 0 := rfl

@[simp] theorem coeff_intCast_raw (n : ℤ) (a : ι → ℕ) :
    ((n : Hur ι)).coeff a = if a = 0 then n else 0 := rfl

end Basic

section ToQ

variable [Fintype ι] [DecidableEq ι]

/-- `∏ i, (a i)!`. -/
def factorialProd (a : ι → ℕ) : ℕ := ∏ i, (a i).factorial

@[simp] theorem factorialProd_zero : factorialProd (ι := ι) (fun _ => 0) = 1 := by
  simp [factorialProd]

theorem factorialProd_zero' (a : ι → ℕ) (ha : a = 0) : factorialProd a = 1 := by
  subst a
  exact factorialProd_zero

theorem factorialProd_ne_zero (a : ι → ℕ) : factorialProd a ≠ 0 := by
  classical
  unfold factorialProd
  exact Finset.prod_ne_zero_iff.mpr (fun i _ => (a i).factorial_ne_zero)

theorem factorialProd_pos (a : ι → ℕ) : 0 < factorialProd a :=
  Nat.pos_of_ne_zero (factorialProd_ne_zero a)

/-- Map a Hurwitz series into `MvPowerSeries ι ℚ` by dividing each coefficient
by the factorial product. -/
def toQ (f : Hur ι) : MvPowerSeries ι ℚ :=
  fun α => (f.coeff (Finsupp.equivFunOnFinite α) : ℚ) /
    (factorialProd (Finsupp.equivFunOnFinite α) : ℚ)

theorem toQ_apply (f : Hur ι) (α : ι →₀ ℕ) :
    toQ f α = (f.coeff (Finsupp.equivFunOnFinite α) : ℚ) /
      (factorialProd (Finsupp.equivFunOnFinite α) : ℚ) := rfl

theorem toQ_at (f : Hur ι) (a : ι → ℕ) :
    toQ f (Finsupp.equivFunOnFinite.symm a) = (f.coeff a : ℚ) / (factorialProd a : ℚ) := by
  rw [toQ_apply, Equiv.apply_symm_apply]

theorem toQ_injective : Function.Injective (toQ : Hur ι → MvPowerSeries ι ℚ) := by
  intro f g h
  ext a
  have h' := congrFun h (Finsupp.equivFunOnFinite.symm a)
  rw [toQ_at, toQ_at] at h'
  have hden : (factorialProd a : ℚ) ≠ 0 := by
    exact_mod_cast factorialProd_ne_zero a
  have h'' := div_eq_div_iff hden hden |>.mp h'
  -- h'' : (f.coeff a : ℚ) * factorialProd a = g.coeff a * factorialProd a
  have hcast : ((f.coeff a : ℤ) : ℚ) = ((g.coeff a : ℤ) : ℚ) := by
    have := mul_right_cancel₀ hden h''
    exact_mod_cast this
  exact_mod_cast hcast

@[simp] theorem toQ_zero : toQ (0 : Hur ι) = 0 := by
  funext α
  rw [toQ_apply, coeff_zero_raw, Int.cast_zero, zero_div]
  rfl

@[simp] theorem toQ_add (f g : Hur ι) : toQ (f + g) = toQ f + toQ g := by
  funext α
  rw [toQ_apply, coeff_add_raw]
  show ((f.coeff _ + g.coeff _ : ℤ) : ℚ) / _ = toQ f α + toQ g α
  rw [toQ_apply, toQ_apply, ← add_div]
  push_cast
  ring

@[simp] theorem toQ_neg (f : Hur ι) : toQ (-f) = -toQ f := by
  funext α
  rw [toQ_apply, coeff_neg_raw]
  show ((-f.coeff _ : ℤ) : ℚ) / _ = -(toQ f α)
  rw [toQ_apply, ← neg_div]
  push_cast
  ring

@[simp] theorem toQ_sub (f g : Hur ι) : toQ (f - g) = toQ f - toQ g := by
  funext α
  rw [toQ_apply, coeff_sub_raw]
  show ((f.coeff _ - g.coeff _ : ℤ) : ℚ) / _ = toQ f α - toQ g α
  rw [toQ_apply, toQ_apply, ← sub_div]
  push_cast
  ring

@[simp] theorem toQ_one : toQ (1 : Hur ι) = 1 := by
  funext α
  rw [toQ_apply]
  change ((if Finsupp.equivFunOnFinite α = (0 : ι → ℕ) then (1 : ℤ) else 0 : ℤ) : ℚ) /
      (factorialProd (Finsupp.equivFunOnFinite α) : ℚ)
    = (1 : MvPowerSeries ι ℚ) α
  have h_one : (1 : MvPowerSeries ι ℚ) α = if α = 0 then 1 else 0 :=
    MvPowerSeries.coeff_one (n := α)
  rw [h_one]
  by_cases hα : α = 0
  · subst hα
    have h_eq : Finsupp.equivFunOnFinite (0 : ι →₀ ℕ) = (0 : ι → ℕ) := rfl
    have h_eq' : (0 : ι → ℕ) = (fun _ => 0) := rfl
    rw [h_eq, h_eq', factorialProd_zero]
    push_cast
    simp
  · have hneq : Finsupp.equivFunOnFinite α ≠ (0 : ι → ℕ) := by
      intro heq
      apply hα
      have heq' : Finsupp.equivFunOnFinite.symm (Finsupp.equivFunOnFinite α) =
          Finsupp.equivFunOnFinite.symm (0 : ι → ℕ) := by rw [heq]
      rw [Equiv.symm_apply_apply] at heq'
      rw [heq']
      ext i
      rfl
    rw [if_neg hα, if_neg hneq]
    simp

end ToQ

section MulCompat

variable [Fintype ι] [DecidableEq ι]

/-- For `b + c = a` (pointwise), the factorial identity
`mchoose a b * factorialProd b * factorialProd c = factorialProd a`. -/
theorem factorial_factorial_choose {a b c : ι → ℕ} (h : b + c = a) :
    mchoose a b * factorialProd b * factorialProd c = factorialProd a := by
  classical
  simp only [mchoose, factorialProd, ← Finset.prod_mul_distrib]
  apply Finset.prod_congr rfl
  intro i _
  -- at each i: `(a i).choose (b i) * (b i)! * (c i)! = (a i)!`
  have hi : b i + c i = a i := congrFun h i
  have hle : b i ≤ a i := by omega
  have hi_result : (a i).choose (b i) * (b i).factorial * (c i).factorial = (a i).factorial := by
    have h := Nat.choose_mul_factorial_mul_factorial hle
    have hc : c i = a i - b i := by omega
    rw [hc, h]
  simpa [mul_assoc] using hi_result

/-- Reindexing an antidiagonal sum of `ι →₀ ℕ` over `piFinset`. -/
theorem antidiagonal_sum_eq_piFinset_sum {M : Type*} [AddCommMonoid M]
    (α : ι →₀ ℕ) (T : (ι →₀ ℕ) → (ι →₀ ℕ) → M) :
    ∑ p ∈ Finset.antidiagonal α, T p.1 p.2
      = ∑ b ∈ Fintype.piFinset (fun i => Finset.range ((Finsupp.equivFunOnFinite α) i + 1)),
          T (Finsupp.equivFunOnFinite.symm b)
            (Finsupp.equivFunOnFinite.symm ((Finsupp.equivFunOnFinite α) - b)) := by
  classical
  refine Finset.sum_bij (s := Finset.antidiagonal α)
    (t := Fintype.piFinset (fun i => Finset.range ((Finsupp.equivFunOnFinite α) i + 1)))
    (i := fun p _ => Finsupp.equivFunOnFinite p.1) ?_ ?_ ?_ ?_
  · -- hi: maps into piFinset
    intro p hp
    rw [Finset.mem_antidiagonal] at hp
    obtain ⟨β, γ⟩ := p
    rw [Fintype.mem_piFinset]
    intro i
    rw [Finset.mem_range]
    have hi : (β + γ) i = α i := by rw [hp]
    simp only [Finsupp.add_apply] at hi
    change (Finsupp.equivFunOnFinite β) i + 1 ≤ (Finsupp.equivFunOnFinite α) i + 1
    have hi' : (Finsupp.equivFunOnFinite β) i + (Finsupp.equivFunOnFinite γ) i =
        (Finsupp.equivFunOnFinite α) i := hi
    omega
  · -- i_inj
    intro p hp q hq heq
    rw [Finset.mem_antidiagonal] at hp
    rw [Finset.mem_antidiagonal] at hq
    obtain ⟨β1, γ1⟩ := p
    obtain ⟨β2, γ2⟩ := q
    simp only at heq
    have hβ : β1 = β2 := Finsupp.equivFunOnFinite.injective heq
    have hγ : γ1 = γ2 := by
      have h2 : β1 + γ1 = α := hp
      have h2' : β2 + γ2 = α := hq
      have : β1 + γ2 = α := hβ ▸ h2'
      exact add_left_cancel (h2.trans this.symm)
    rw [hβ, hγ]
  · -- i_surj
    intro b hb
    have hb_le : ∀ i, b i ≤ (Finsupp.equivFunOnFinite α) i := by
      intro i
      have := (Fintype.mem_piFinset).mp hb i
      simp only [Finset.mem_range] at this
      omega
    refine ⟨(Finsupp.equivFunOnFinite.symm b, Finsupp.equivFunOnFinite.symm
      ((Finsupp.equivFunOnFinite α) - b)), ?_, rfl⟩
    rw [Finset.mem_antidiagonal]
    ext i
    simp only [Finsupp.add_apply]
    change b i + ((Finsupp.equivFunOnFinite α) i - b i) = (Finsupp.equivFunOnFinite α) i
    have := hb_le i
    omega
  · -- h: the values agree
    intro p hp
    obtain ⟨β, γ⟩ := p
    rw [Finset.mem_antidiagonal] at hp
    simp only
    rw [Equiv.symm_apply_apply]
    have hαγ : (Finsupp.equivFunOnFinite α) - (Finsupp.equivFunOnFinite β) =
        Finsupp.equivFunOnFinite γ := by
      funext i
      have hi : (β + γ) i = α i := by rw [hp]
      simp only [Finsupp.add_apply] at hi
      have hi' : (Finsupp.equivFunOnFinite β) i + (Finsupp.equivFunOnFinite γ) i =
          (Finsupp.equivFunOnFinite α) i := hi
      show (Finsupp.equivFunOnFinite α) i - (Finsupp.equivFunOnFinite β) i =
          (Finsupp.equivFunOnFinite γ) i
      omega
    rw [hαγ, Equiv.symm_apply_apply]

/-- `toQ` respects multiplication. -/
@[simp] theorem toQ_mul (f g : Hur ι) : toQ (f * g) = toQ f * toQ g := by
  classical
  funext α
  set a : ι → ℕ := Finsupp.equivFunOnFinite α with ha
  -- LHS = `(f * g).coeff a / factorialProd a`.
  show ((f * g).coeff a : ℚ) / (factorialProd a : ℚ) = (toQ f * toQ g) α
  rw [coeff_mul_raw]
  push_cast
  rw [Finset.sum_div]
  -- LHS: `∑ b ∈ piFinset, (mchoose a b * f.coeff b * g.coeff (a - b) : ℤ) / factorialProd a`
  -- Each term: together with `factorial_factorial_choose`,
  --   `(mchoose a b) / factorialProd a = 1 / (factorialProd b * factorialProd (a - b))`.
  have hLHS : ∑ b ∈ Fintype.piFinset (fun i => Finset.range (a i + 1)),
        (mchoose a b : ℚ) * (f.coeff b : ℚ) * (g.coeff (a - b) : ℚ) / (factorialProd a : ℚ)
      = ∑ b ∈ Fintype.piFinset (fun i => Finset.range (a i + 1)),
          (f.coeff b : ℚ) / factorialProd b * ((g.coeff (a - b) : ℚ) / factorialProd (a - b)) := by
    apply Finset.sum_congr rfl
    intro b hb
    -- mem: each b i ≤ a i
    have hb_le : ∀ i, b i ≤ a i := by
      intro i
      have := (Fintype.mem_piFinset).mp hb i
      simp only [Finset.mem_range] at this
      omega
    have hbadd : b + (a - b) = a := by
      funext i
      simp only [Pi.add_apply, Pi.sub_apply]
      have := hb_le i
      omega
    have hfact : mchoose a b * factorialProd b * factorialProd (a - b) = factorialProd a :=
      factorial_factorial_choose hbadd
    have hfa : (factorialProd a : ℚ) =
        (mchoose a b : ℚ) * (factorialProd b : ℚ) * (factorialProd (a - b) : ℚ) := by
      have : ((mchoose a b * factorialProd b * factorialProd (a - b) : ℕ) : ℚ) = (factorialProd a : ℚ) := by
        exact_mod_cast hfact
      push_cast at this
      linarith
    -- LHS term to RHS via clearing denominators
    have hb_ne : (factorialProd b : ℚ) ≠ 0 := by exact_mod_cast factorialProd_ne_zero b
    have hcb_ne : (factorialProd (a - b) : ℚ) ≠ 0 := by exact_mod_cast factorialProd_ne_zero (a - b)
    have hmc : (mchoose a b : ℚ) =
        (factorialProd a : ℚ) / ((factorialProd b : ℚ) * (factorialProd (a - b) : ℚ)) := by
      rw [hfa]
      field_simp
    rw [hmc]
    have ha_ne : (factorialProd a : ℚ) ≠ 0 := by exact_mod_cast factorialProd_ne_zero a
    field_simp
  rw [hLHS]
  -- RHS: expand MvPowerSeries multiplication
  have hmul : (toQ f * toQ g) α =
      ∑ p ∈ Finset.antidiagonal α, toQ f p.1 * toQ g p.2 := by
    exact MvPowerSeries.coeff_mul (n := α) (φ := toQ f) (ψ := toQ g)
  rw [hmul]
  rw [antidiagonal_sum_eq_piFinset_sum α (fun β γ => toQ f β * toQ g γ)]
  apply Finset.sum_congr rfl
  intro b _
  -- Each term: `toQ f (equivFunOnFinite.symm b) * toQ g (equivFunOnFinite.symm (a - b))`
  --   = `(f.coeff b / factorialProd b) * (g.coeff (a - b) / factorialProd (a - b))`
  have h1 : toQ f (Finsupp.equivFunOnFinite.symm b) = (f.coeff b : ℚ) / factorialProd b := toQ_at f b
  have h2 : toQ g (Finsupp.equivFunOnFinite.symm (a - b)) = (g.coeff (a - b) : ℚ) / factorialProd (a - b) := toQ_at g (a - b)
  rw [h1, h2]

end MulCompat


section ToQCompat

variable [Fintype ι] [DecidableEq ι]

@[simp] theorem toQ_nsmul (n : ℕ) (f : Hur ι) : toQ (n • f) = n • toQ f := by
  induction n with
  | zero =>
    have h : ((0 : ℕ) • f) = (0 : Hur ι) := by ext a; simp [coeff_nsmul_raw]
    rw [h, toQ_zero, zero_smul]
  | succ n ih =>
    have h : ((n + 1 : ℕ) • f) = (n • f) + f := by
      ext a
      simp [coeff_nsmul_raw, coeff_add_raw]
      ring
    rw [h, toQ_add, ih, succ_nsmul]

@[simp] theorem toQ_natCast (n : ℕ) : toQ ((n : Hur ι)) = (n : MvPowerSeries ι ℚ) := by
  induction n with
  | zero =>
    have h : ((0 : ℕ) : Hur ι) = 0 := by ext a; simp [coeff_natCast_raw]
    rw [h, toQ_zero]
    norm_cast
  | succ n ih =>
    have h : ((n + 1 : ℕ) : Hur ι) = (n : Hur ι) + 1 := by
      ext a
      simp [coeff_natCast_raw, coeff_add_raw]
      split_ifs <;> push_cast <;> ring
    rw [h, toQ_add, toQ_one, ih]
    norm_cast

@[simp] theorem toQ_pow (f : Hur ι) (n : ℕ) : toQ (f ^ n) = (toQ f) ^ n := by
  induction n with
  | zero => exact toQ_one
  | succ n ih =>
    change toQ (npowRec (n + 1) f) = (toQ f) ^ (n + 1)
    rw [npowRec.eq_def, toQ_mul]
    have ihp : toQ (npowRec n f) = (toQ f) ^ n := ih
    rw [ihp, pow_succ]

@[simp] theorem toQ_intCast (n : ℤ) : toQ ((n : Hur ι)) = (n : MvPowerSeries ι ℚ) := by
  cases n with
  | ofNat n =>
    change toQ ((n : Hur ι)) = (n : MvPowerSeries ι ℚ)
    exact toQ_natCast n
  | negSucc n =>
    change toQ ((Int.negSucc n : Hur ι)) = (Int.negSucc n : MvPowerSeries ι ℚ)
    have h : ((Int.negSucc n : ℤ) : Hur ι) = -((n + 1 : ℕ) : Hur ι) := by
      ext a
      simp [coeff_intCast_raw, coeff_neg_raw, coeff_natCast_raw, Int.negSucc_eq]
      split_ifs <;> push_cast <;> ring
    rw [h, toQ_neg, toQ_natCast]
    push_cast
    rfl

@[simp] theorem toQ_zsmul (n : ℤ) (f : Hur ι) : toQ (n • f) = n • toQ f := by
  funext a
  change ((n • f).coeff (Finsupp.equivFunOnFinite a) : ℚ) /
    (factorialProd (Finsupp.equivFunOnFinite a) : ℚ) =
    (MvPowerSeries.coeff a) (n • toQ f)
  rw [coeff_zsmul_raw]
  push_cast
  rw [mul_div_assoc]
  rw [map_zsmul]
  convert (Int.cast_smul_eq_zsmul ℚ n ((toQ f) a)).symm using 2 <;> rfl

end ToQCompat

section Ring

variable [Fintype ι] [DecidableEq ι]

instance instCommRing : CommRing (Hur ι) :=
  Function.Injective.commRing toQ toQ_injective toQ_zero toQ_one toQ_add toQ_mul
    toQ_neg toQ_sub toQ_nsmul toQ_zsmul toQ_pow toQ_natCast toQ_intCast

theorem coeff_zero' (a : ι → ℕ) : (0 : Hur ι).coeff a = 0 := coeff_zero_raw a
theorem coeff_one' (a : ι → ℕ) : (1 : Hur ι).coeff a = if a = 0 then 1 else 0 := coeff_one_raw a
theorem coeff_add' (f g : Hur ι) (a : ι → ℕ) : (f + g).coeff a = f.coeff a + g.coeff a :=
  coeff_add_raw f g a
theorem coeff_neg' (f : Hur ι) (a : ι → ℕ) : (-f).coeff a = -f.coeff a := coeff_neg_raw f a
theorem coeff_nsmul' (n : ℕ) (f : Hur ι) (a : ι → ℕ) : (n • f).coeff a = n * f.coeff a :=
  coeff_nsmul_raw n f a
theorem coeff_mul' (f g : Hur ι) (a : ι → ℕ) :
    (f * g).coeff a = ∑ b ∈ Fintype.piFinset (fun i => Finset.range (a i + 1)),
      (mchoose a b : ℤ) * f.coeff b * g.coeff (a - b) := coeff_mul_raw f g a

end Ring

section ConstVar

variable [Fintype ι] [DecidableEq ι]

/-- The constant coefficient of a Hurwitz series. -/
def constCoeff : Hur ι →+* ℤ where
  toFun f := f.coeff 0
  map_one' := by simp [coeff_one']
  map_mul' f g := by
    rw [coeff_mul_raw]
    simp only [Pi.zero_apply, zero_add, Finset.range_one]
    rw [Fintype.piFinset_singleton]
    simp [mchoose, sub_zero]
    change f.coeff (fun _ => 0) * g.coeff (fun _ => 0) = f.coeff 0 * g.coeff 0
    rfl
  map_zero' := coeff_zero' 0
  map_add' f g := coeff_add' f g 0

/-- The coordinate variable `z_c`, with coefficient one at `e_c`. -/
def var (c : ι) : Hur ι := ⟨fun a => if a = Pi.single c 1 then 1 else 0⟩

theorem coeff_pow_zero (f : Hur ι) (n : ℕ) : (f ^ n).coeff 0 = (f.coeff 0) ^ n := by
  change constCoeff (f ^ n) = (constCoeff f) ^ n
  exact map_pow constCoeff f n

end ConstVar

section Derivative

variable [Fintype ι] [DecidableEq ι]

/-- ∂/∂z_c: on coefficients it is the shift by the unit vector e_c. -/
def der (c : ι) (f : Hur ι) : Hur ι := ⟨fun a => f.coeff (a + Pi.single c 1)⟩

@[simp] theorem coeff_der (c : ι) (f : Hur ι) (a : ι → ℕ) :
    (der c f).coeff a = f.coeff (a + Pi.single c 1) := rfl

theorem factorialProd_add_single (a : ι → ℕ) (c : ι) :
    factorialProd (a + Pi.single c 1) = (a c + 1) * factorialProd a := by
  classical
  have h : (a c).factorial * (∏ x ∈ Finset.univ.erase c, (a x).factorial) =
      ∏ x ∈ Finset.univ, (a x).factorial :=
    Finset.mul_prod_erase Finset.univ (fun i => (a i).factorial) (Finset.mem_univ c)
  unfold factorialProd
  simp only [Pi.add_apply]
  rw [← Finset.prod_erase_mul Finset.univ
    (fun i => (a i + (Pi.single c (1 : ℕ) : ι → ℕ) i).factorial) (Finset.mem_univ c)]
  have hothers : ∀ i ∈ Finset.univ.erase c,
      (a i + (Pi.single c (1 : ℕ) : ι → ℕ) i).factorial = (a i).factorial := by
    intro i hi
    rw [Pi.single_apply, if_neg (Finset.ne_of_mem_erase hi), add_zero]
  rw [Finset.prod_congr rfl hothers]
  have hc : (a c + (Pi.single c (1 : ℕ) : ι → ℕ) c).factorial =
      (a c + 1) * (a c).factorial := by simp [Nat.factorial_succ]
  rw [hc]
  calc
    _ = (a c + 1) * ((a c).factorial * ∏ i ∈ Finset.univ.erase c, (a i).factorial) := by ring
    _ = _ := by rw [h]

@[simp] theorem toQ_der (c : ι) (f : Hur ι) :
    toQ (der c f) = MvPowerSeries.pderiv c (toQ f) := by
  funext α
  change toQ (der c f) α = (MvPowerSeries.coeff α) (MvPowerSeries.pderiv c (toQ f))
  rw [toQ_apply, coeff_der, MvPowerSeries.coeff_pderiv]
  change _ = (f.coeff (Finsupp.equivFunOnFinite (α + Finsupp.single c 1)) : ℚ) /
    (factorialProd (Finsupp.equivFunOnFinite (α + Finsupp.single c 1)) : ℚ) * (↑(α c) + 1)
  have he : Finsupp.equivFunOnFinite (α + Finsupp.single c 1) =
      Finsupp.equivFunOnFinite α + Pi.single c 1 := by
    ext i
    by_cases h : c = i
    · subst i
      simp [Pi.single_apply, Finsupp.single_apply]
    · simp [Pi.single_apply, Finsupp.single_apply, h, Ne.symm h]
  rw [he, factorialProd_add_single]
  push_cast
  have ha0 : (factorialProd (Finsupp.equivFunOnFinite α) : ℚ) ≠ 0 := by
    exact_mod_cast factorialProd_ne_zero (Finsupp.equivFunOnFinite α)
  field_simp
  rfl

theorem der_add (c : ι) (f g : Hur ι) :
    der c (f + g) = der c f + der c g := by
  apply toQ_injective
  rw [toQ_add, toQ_der, toQ_der, toQ_add, map_add]

theorem der_mul (c : ι) (f g : Hur ι) :
    der c (f * g) = der c f * g + f * der c g := by
  apply toQ_injective
  rw [toQ_add, toQ_mul, toQ_mul, toQ_der, toQ_mul, toQ_der, toQ_der]
  exact (MvPowerSeries.pderiv c).leibniz (toQ f) (toQ g)

theorem der_one (c : ι) : der c (1 : Hur ι) = 0 := by
  apply toQ_injective
  rw [toQ_der, toQ_one, toQ_zero, map_one_eq_zero (MvPowerSeries.pderiv c)]

theorem der_nsmul (c : ι) (n : ℕ) (f : Hur ι) : der c (n • f) = n • der c f := by
  apply toQ_injective
  rw [toQ_der, toQ_nsmul, toQ_nsmul, toQ_der, map_nsmul]

theorem der_comm (c c' : ι) (f : Hur ι) : der c (der c' f) = der c' (der c f) := by
  ext a
  simp only [coeff_der, add_assoc, add_comm (Pi.single c 1)]

theorem der_var (c c' : ι) : der c (var c') = if c = c' then 1 else 0 := by
  ext a
  by_cases h : c = c'
  · subst c'
    simp only [if_pos rfl, der, var, coeff_one']
    have he : a + Pi.single c 1 = Pi.single c 1 ↔ a = 0 := by
      rw [← add_left_eq_self]
      exact add_eq_left
    simp [he]
  · have he : a + Pi.single c 1 ≠ Pi.single c' 1 := by
      intro heq
      have hi := congrFun heq c'
      simp [Pi.single_apply, h] at hi
    simp [der, var, he, h, coeff_one']

theorem der_pow_succ (c : ι) (f : Hur ι) (n : ℕ) :
    der c (f ^ (n + 1)) = (n + 1) • (f ^ n * der c f) := by
  induction n with
  | zero => simp [der_one]
  | succ n ih =>
    rw [show n + 1 + 1 = (n + 1) + 1 by omega, pow_succ, der_mul, ih]
    rw [add_nsmul, one_nsmul, add_nsmul, one_nsmul]
    simp only [mul_assoc]
    rw [← der_mul]
    have hpow : f ^ n * f = f ^ (n + 1) := (pow_succ f n).symm
    have hpow' : f ^ (n + 1) * der c f = f ^ n * (f * der c f) := by
      rw [← mul_assoc, hpow]
    rw [← hpow']
    abel

theorem coeff_eq_der (f : Hur ι) (a : ι → ℕ) (c : ι) (hc : 0 < a c) :
    f.coeff a = (der c f).coeff (a - Pi.single c 1) := by
  rw [coeff_der, ← add_zero a, ← sub_add_cancel (Pi.single_le_iff.mpr ?_)]
  · exact congrArg f.coeff (by simp)
  · exact Nat.succ_le_iff.mp hc

end Derivative

end Hur

end MMM.Frob
